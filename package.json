{
    "name": "@postalsys/otp-detect",
    "version": "0.0.0",
    "description": "Detect one-time codes (OTP) in email messages",
    "author": "Postal Systems OÜ",
    "license": "MIT",
    "type": "module",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --import tsx --test $(find test -name '*.test.ts')",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --import tsx --test $(find test -name '*.test.ts')",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dump-features": "node --import tsx scripts/dump-features.ts",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install",
        "prepare": "npm run build"
    },
    "devDependencies": {
        "@types/node": "20.19.43",
        "c8": "12.0.0",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.14.0",
        "postal-mime": "4.2.1",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/otp-detect.git"
    },
    "keywords": [
        "email",
        "otp",
        "one-time-password",
        "verification-code",
        "2fa",
        "machine-learning"
    ],
    "homepage": "https://github.com/postalsys/otp-detect#readme",
    "bugs": {
        "url": "https://github.com/postalsys/otp-detect/issues"
    }
}
